# HireIQ: Autonomous Multi-Agent Research Swarm
# Environment Configuration Template

# --- LLM CONFIGURATION (Groq) ---
# Get your key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# --- SEARCH CONFIGURATION (Tavily AI) ---
# Get your key at: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# --- DATABASE CONFIGURATION ---
# Default is local SQLite (hireiq.db)
DATABASE_URL=sqlite:///./hireiq.db

# --- OBSERVABILITY (LangSmith) ---
# Get your key at: https://smith.langchain.com/
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT="HireIQ-Swarm"

# --- APP CONFIGURATION ---
# Port for the FastAPI backend
PORT=8000
DEBUG=True
